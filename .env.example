# Postgres (internal Docker network only)
POSTGRES_USER=localfakemail
POSTGRES_PASSWORD=localfakemail
POSTGRES_DB=localfakemail

# Host ports (bound to 127.0.0.1 only)
WEB_PORT=8025
SMTP_PORT=1025

# Retention: keep the most recent N emails
EMAIL_RETENTION_LIMIT=500

# Database URL used by web + smtp containers
DATABASE_URL=postgresql://localfakemail:localfakemail@db:5432/localfakemail
